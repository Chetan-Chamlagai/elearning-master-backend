pipeline {
    agent any
    triggers {
        githubPush()
    }
    environment {
        IMAGE = 'sandip8085/e_learning_platform_sandip'
    }
    stages {
        stage('Check Commit Message') {
            steps {
                script {
                    def commitMsg = sh(script: "git log -1 --pretty=%B", returnStdout: true).trim()
                    echo "Commit: ${commitMsg}"
                    if (!commitMsg.contains("[skip ci]") && commitMsg.contains("#ok")) {
                        env.SHOULD_BUILD = 'true'
                        echo "Build approved"
                    } else {
                        env.SHOULD_BUILD = 'false'
                        echo "Skipping — not marked #ok or [skip ci] detected"
                    }
                }
            }
        }
        stage('Build with Maven') {
            when { expression { env.SHOULD_BUILD == 'true' } }
            steps {
                sh 'mvn -B -ntp -T 1C package -DskipTests'
            }
        }
        stage('Docker Build & Push') {
            when { expression { env.SHOULD_BUILD == 'true' } }
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DH_USER',
                        passwordVariable: 'DH_TOKEN'
                    )
                ]) {
                    sh '''
                        echo "$DH_TOKEN" | docker login -u "$DH_USER" --password-stdin
                        docker build \
                            -t ${IMAGE}:${GIT_COMMIT} \
                            -t ${IMAGE}:latest .
                        docker push ${IMAGE}:${GIT_COMMIT}
                        docker push ${IMAGE}:latest
                        docker logout
                    '''
                }
            }
        }
        stage('Update Manifest') {
            when { expression { env.SHOULD_BUILD == 'true' } }
            steps {
                withCredentials([
                    string(credentialsId: 'github-token', variable: 'GH_TOKEN')
                ]) {
                    sh '''
                        sed -i "s|image: ${IMAGE}:.*|image: ${IMAGE}:${GIT_COMMIT}|" k8s/app.yaml
                        git config user.email "sandipchapagain797@gmail.com"
                        git config user.name "sandip8085"
                        git remote set-url origin https://${GH_TOKEN}@github.com/sndp231998/E_Learning_Platform_Sandip.git
                        git add k8s/app.yaml
                        git diff --cached --quiet || git commit -m "ci: update e_learning_platform_sandip image to ${GIT_COMMIT} [skip ci]"
                        git push origin HEAD:master
                    '''
                }
            }
        }
        stage('Notify') {
            when { expression { env.SHOULD_BUILD == 'true' } }
            steps {
                echo "e_learning_platform_sandip deployed — ${env.GIT_COMMIT}"
            }
        }
    }
}
